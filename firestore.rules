rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===== 開発用設定（セキュリティを緩く設定） =====
    // 本番環境では適切な認証制限を再設定してください

    // ユーザーコレクション（開発用：読み取り全許可）
    match /users/{userId} {
      allow read: if true; // 開発用：全許可
      allow write: if false; // 書き込みはCloud Functions経由のみ
      
      // ログサブコレクション（pointALogs, pointBLogs, sideGameChipLogs）
      match /{logCollection=**} {
        allow read: if true; // 開発用：全許可
        allow write: if false; // 書き込みはCloud Functions経由のみ
      }
    }

    match /staffs/{staffId} {
      allow read: if true; // 開発用：全許可
      allow write: if false; // 書き込みはCloud Functions経由のみ
    }

    // scheduledTournaments関連のルール（開発用：読み取り全許可）
    match /scheduledTournaments/{tournamentId} {
      // トーナメント基本情報の読み取り（開発用：全許可）
      allow read: if true;
      allow write: if false; // 書き込みはCloud Functions経由のみ



      // views サブコレクションの読み取り（開発用：全許可）
      match /views/{viewId} {
        allow read: if true;
        allow write: if false; // 書き込みはCloud Functions経由のみ
      }

      // tablesSeat サブコレクションの読み取り（開発用：全許可）
      match /tablesSeat/{docId} {
        allow read: if true;
        allow write: if false; // 書き込みはCloud Functions経由のみ
      }

      // actionLog サブコレクションの読み取り（開発用：全許可）
      match /actionLog/{logId} {
        allow read: if true;
        allow write: if false; // 書き込みはCloud Functions経由のみ
      }

      // users サブコレクション（開発用：読み取り全許可）
      match /users/{userId} {
        allow read: if true;
        allow write: if false; // 書き込みはCloud Functions経由のみ
      }

      // tables サブコレクション（開発用：読み取り全許可）
      match /tables/{tableId} {
        allow read: if true;
        allow write: if false; // 書き込みはCloud Functions経由のみ
      }

      // events サブコレクション（開発用：読み取り全許可）
      match /events/{eventId} {
        allow read: if true;
        allow write: if false; // 書き込みはCloud Functions経由のみ
      }

      // taskIndex サブコレクション（Step 9）
      // 内部台帳。enqueue バッチ・controlHook が Admin SDK で読み書き。クライアント非公開。
      // docID は taskType（startTournament, closeRegistration）。
      match /taskIndex/{taskType} {
        allow read, write: if false;
      }
    }

    // tournamentTemplates の読み取り（開発用：全許可）
    match /tournamentTemplates/{templateId} {
      allow read: if true;
      allow write: if false; // 書き込みはCloud Functions経由のみ
    }

    // recurrenceRules の読み取り（開発用：全許可）
    match /recurrenceRules/{ruleId} {
      allow read: if true;
      allow write: if false; // 書き込みはCloud Functions経由のみ
    }

    // todaysBills の読み取り（開発用：全許可）
    match /todaysBills/{billId} {
      allow read: if true;
      allow write: if false; // 書き込みはCloud Functions経由のみ
    }

    // tables の読み取り・書き込み（開発用：全許可）
    match /tables/{tableId} {
      allow read: if true; // 開発用：全許可
      allow write: if true; // 開発用：全許可
    }

    // sideGame の読み取り・書き込み（開発用：全許可）
    match /sideGame/{tableId} {
      allow read: if true; // 開発用：全許可
      allow write: if true; // 開発用：全許可
    }

    // デバイスコレクション（開発用：読み取り全許可）
    match /devices/{deviceId} {
      allow read: if true; // 開発用：全許可
      allow write: if false; // 書き込みはCloud Functions経由のみ
    }

    // シフトコレクション
    match /shifts/{shiftId} {
      // 読み取り: 全ユーザー（テスト用）
      allow read: if true;

      // 書き込み: 全ユーザー（テスト用）
      allow write: if true;
      
      // days サブコレクション
      match /days/{dayId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // 営業時間月次マップコレクション
    match /businessHoursMonthlyMap/{yearMonth} {
      // 読み取り: 全ユーザー（テスト用）
      allow read: if true;
      
      // 書き込み: Cloud Functions経由のみ
      allow write: if false;
    }

    // シフト申請コレクション
    match /shiftRequests/{requestId} {
      // 読み取り: 全ユーザー（テスト用）
      allow read: if true;
      
      // 書き込み: Cloud Functions経由のみ（申請作成はCallable経由）
      allow write: if false;
    }

    // 勤怠コレクション（開発用：読み取り全許可）
    match /attendances/{attendanceId} {
      allow read: if true; // 開発用：全許可
      allow write: if false; // 書き込みはCloud Functions経由のみ

      // 休憩サブコレクション（endBreakForAttendance で endedAt==null の break を取得するため読み取り許可）
      match /breaks/{breakId} {
        allow read: if true; // 開発用：全許可
        allow write: if false; // 書き込みはCloud Functions経由のみ
      }
    }

    // 勤怠修正申請コレクション（開発用：読み取り全許可）
    match /attendanceCorrectionRequests/{requestId} {
      allow read: if true; // 開発用：全許可
      allow write: if false; // 書き込みはCloud Functions経由のみ
    }

    // 会計履歴コレクション（開発用：読み取り全許可）
    match /accountingHistory/{historyId} {
      allow read: if true; // 開発用：全許可
      allow write: if false; // 書き込みはCloud Functions経由のみ
    }

    // orders コレクション（開発用：読み取り・書き込み全許可）
    match /orders/{orderId} {
      allow read: if true; // 開発用：全許可
      allow write: if true; // 開発用：全許可
      
      // _TodaysOrders サブコレクション
      match /_TodaysOrders/{subOrderId} {
        allow read: if true; // 開発用：全許可
        allow write: if true; // 開発用：全許可
      }
    }

    // analyticsMonthly コレクション（開発用：読み取り全許可）
    match /analyticsMonthly/{monthId} {
      allow read: if true; // 開発用：全許可
      allow write: if false; // 書き込みはCloud Functions経由のみ
      
      // days サブコレクション
      match /days/{dayId} {
        allow read: if true; // 開発用：全許可
        allow write: if false; // 書き込みはCloud Functions経由のみ
      }
      
      // byCategory サブコレクション
      match /byCategory/{categoryId} {
        allow read: if true; // 開発用：全許可
        allow write: if false; // 書き込みはCloud Functions経由のみ
      }
      
      // byTemplateTournaments サブコレクション
      match /byTemplateTournaments/{templateId} {
        allow read: if true; // 開発用：全許可
        allow write: if false; // 書き込みはCloud Functions経由のみ
      }
      
      // byUser サブコレクション
      match /byUser/{userId} {
        allow read: if true; // 開発用：全許可
        allow write: if false; // 書き込みはCloud Functions経由のみ
      }
      
      // aggregationMarkers サブコレクション
      match /aggregationMarkers/{markerId} {
        allow read: if true; // 開発用：全許可
        allow write: if false; // 書き込みはCloud Functions経由のみ
      }
    }

    // settledBills コレクション（開発用：読み取り全許可）
    match /settledBills/{dateId} {
      allow read: if true; // 開発用：全許可
      allow write: if false; // 書き込みはCloud Functions経由のみ
      
      match /{billId} {
        allow read: if true; // 開発用：全許可
        allow write: if false; // 書き込みはCloud Functions経由のみ
      }
    }

    // 管理者コレクション
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
    }

    // メニューアイテムコレクション（開発用：読み取り全許可）
    match /menuItems/{menuItemId} {
      allow read: if true; // 開発用：全許可
      allow write: if false; // 書き込みはCloud Functions経由のみ
    }

    // activeStays コレクション（最小スキーマ、座席情報は bills.place.* に保持）
    match /activeStays/{uid} {
      // 読み取り: 認証済みユーザーは全員可（在席一覧表示のため）
      allow read: if request.auth != null;
      // 作成・更新・削除: Functions のみ許可（クライアント直書き禁止）
      allow write: if false;
    }

    // bills コレクション（新スキーマ）
    match /bills/{billId} {
      // 読み取り: 認証済みユーザーは全員可（開発用：全許可）
      allow read: if true;
      // 書き込み: Functions のみ許可
      // 親ドキュメントの updatedAt, amounts, categoryBreakdown, paymentsSummary, postEvents は Functions 専任
      // クライアントは status, place.* のみ更新可能（将来実装）
      allow write: if false;
      
      // サブコレクション
      // items, extras, sideGameChips, tournaments: status != "settled" の間のみ書込可（Functions 経由）
      // payments: Functions のみ書込（クライアント直書き禁止）
      // events: Functions のみ書込（クライアント直書き禁止）
      match /payments/{paymentId} {
        // 読み取り: 認証済みユーザーは全員可（開発用：全許可）
        allow read: if true;
        // 書き込み: Functions のみ許可（クライアント直書き禁止）
        allow write: if false;
      }
      
      match /events/{eventId} {
        // 読み取り: 認証済みユーザーは全員可（開発用：全許可）
        allow read: if true;
        // 書き込み: Functions のみ許可（クライアント直書き禁止）
        allow write: if false;
      }
      
      match /items/{itemId} {
        // 読み取り: 認証済みユーザーは全員可（開発用：全許可）
        allow read: if true;
        // 書き込み: Functions のみ許可（クライアント直書き禁止）
        allow write: if false;
      }
      
      match /idempotency/{key} {
        // 読み取り: 認証済みユーザーは全員可（開発用：全許可）
        allow read: if true;
        // 書き込み: Functions のみ許可（完全 Functions 限定）
        allow write: if false;
      }
      
      match /{subcollection}/{subId} {
        // 読み取り: 認証済みユーザーは全員可（開発用：全許可）
        allow read: if true;
        // 書き込み: Functions のみ許可
        allow write: if false;
      }
    }

    // storeMeta/config ドキュメント（店舗設定。StoreConfigService が購読）
    match /storeMeta/config {
      allow read: if true; // 開発用：全許可。必要に応じて request.auth != null に変更
      allow write: if false; // 書き込みは initializeStoreConfigCallable 等 Functions 経由のみ
    }

    // storeMeta/requiredStaffByTimeSlot ドキュメント（R-09 時間帯別必要人数。RequiredStaffByTimeSlotService が購読）
    match /storeMeta/requiredStaffByTimeSlot {
      allow read: if true; // 開発用：全許可
      allow write: if false; // 書き込みは Functions 経由のみ
    }

    // storeMeta/currentBusinessDay コレクション
    match /storeMeta/currentBusinessDay {
      // 読み取り: 全ユーザー許可（UIがsnapshot購読するため）
      // 必要に応じて request.auth != null や staff/admin チェックに変更可能
      allow read: if true;
      // 書き込み: Functions経由のみ（UIからの直接書き込み禁止）
      allow write: if false; // Functionsはadmin権限で実行されるため
    }

    // storeMeta/currentBusinessDay/logs サブコレクション
    match /storeMeta/currentBusinessDay/logs/{logId} {
      // 読み取り: 全ユーザー許可（必要に応じて制限可能）
      allow read: if true;
      // 書き込み: Functions経由のみ
      allow write: if false;
    }

    // storeMeta/currentBusinessDay/assessmentLogs サブコレクション（自動閉店・開店認定のログ）
    match /storeMeta/currentBusinessDay/assessmentLogs/{logId} {
      allow read: if true;
      allow write: if false;
    }

    // その他のコレクションは読み書き禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}